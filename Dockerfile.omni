ARG BASE_IMAGE=ghcr.io/krisitown/local-jev-api:spark-20261013
FROM ${BASE_IMAGE}
RUN python3 -m pip install --no-cache-dir transformers==5.10.2
ENV CLEF_LOAD_DEVICE=cpu
COPY runtime/omni_server.py /app/omni_server.py
ENTRYPOINT ["python3", "-m", "uvicorn", "omni_server:app", "--host", "0.0.0.0", "--port", "18081"]
